# Explicit local-only read-only demo. Remove this line when Supabase is connected.
NEXT_PUBLIC_FINDONE_ADMIN_DEMO=1

# Hosted Admin: set both values and do not enable demo mode at the same time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required by /api/content/stable to mint short-lived private
# release download URLs. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
